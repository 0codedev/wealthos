{
  "name": "[INFRA] System Health Monitor",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "name": "Every 5 Mins",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:8765/api/ready",
        "options": {}
      },
      "name": "Check Python Bridge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "url": "http://127.0.0.1:5000/",
        "options": {}
      },
      "name": "Check OpenAlgo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Every 5 Mins": {
      "main": [
        [
          {
            "node": "Check Python Bridge",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Python Bridge": {
      "main": [
        [
          {
            "node": "Check OpenAlgo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}