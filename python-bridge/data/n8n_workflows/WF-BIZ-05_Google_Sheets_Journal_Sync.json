      "position": [
        450,
        300
      ]
    }
  ],
  "connections": {
    "Hourly Sync": {
      "main": [
        [
          {
            "node": "Fetch Journal Rows",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
