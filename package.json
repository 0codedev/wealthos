{
  "name": "wealth-aggregator-v1.1",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:client": "vite build",
    "check:py": "python -m compileall -q -x \"[\\\\/](\\.venv|venv|__pycache__)\" python-bridge",
    "check:ts": "tsc --noEmit",
    "check:all": "npm run check:py && npm run check:ts",
    "preview": "vite preview",
    "preview:no-pwa": "vite build --mode nopwa && vite preview",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:watch": "vitest",
    "ear": "node scripts/telegram-ear-server.js",
    "ear:discover": "DISCOVERY_MODE=1 node scripts/telegram-ear-server.js",
    "ear:sync-folders": "node scripts/sync-telegram-folders.mjs",
    "ml:ingest-legs": "node --experimental-vm-modules scripts/ml-ingest-legs.mjs",
    "pre-session": "powershell -ExecutionPolicy Bypass -File ./scripts/pre-session.ps1",
    "session-end": "powershell -ExecutionPolicy Bypass -File ./scripts/session-end.ps1",
    "deploy": "powershell -ExecutionPolicy Bypass -File ./scripts/deploy.ps1",
    "vps-check": "powershell -ExecutionPolicy Bypass -File ./scripts/vps-status.ps1",
    "vps-exec": "powershell -ExecutionPolicy Bypass -File ./scripts/vps-exec.ps1",
    "browse": "powershell -ExecutionPolicy Bypass -File ./scripts/open-debug-chrome.ps1",
    "safe-commit": "powershell -ExecutionPolicy Bypass -File ./scripts/safe-commit.ps1",
    "treehouse": "powershell -ExecutionPolicy Bypass -File ./scripts/treehouse.ps1",
    "generate-sdk": "openapi-generator-cli generate -i http://localhost:8765/openapi.json -g typescript-fetch -o src/sdk/wealthos-api/",
    "heal": "node scripts/error_triage_engine.mjs",
    "heal:sweep": "node scripts/capture-errors.mjs",
    "backup:vault": "powershell -ExecutionPolicy Bypass -File ./scripts/backup-vault.ps1",
    "clean:zombies": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-zombies.ps1",
    "lint:tokens": "node scripts/design-system-lint.mjs"
  },
  "dependencies": {
    "@astryxdesign/cli": "^0.6.2",
    "@astryxdesign/core": "^0.6.2",
    "@astryxdesign/theme-neutral": "^0.6.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^1.31.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/supabase-js": "^2.97.0",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/crypto-js": "^4.2.2",
    "@types/papaparse": "^5.5.2",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.1",
    "firebase": "^12.10.0",
    "framer-motion": "^12.23.25",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lightweight-charts": "^5.0.9",
    "lucide-react": "^0.555.0",
    "onnxruntime-web": "^1.20.1",
    "openalgo-charts": "^2.5.1",
    "papaparse": "^5.5.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hook-form": "^7.71.1",
    "react-hotkeys-hook": "^5.2.1",
    "react-is": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.1",
    "recharts": "^3.5.1",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^5.1.1",
    "totp-generator": "^2.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "express": "^4.21.2",
    "input": "^1.0.1",
    "jsdom": "^27.2.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.3",
    "telegram": "^2.26.22",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.0",
    "ws": "^8.20.0"
  }
}
